# ==============================================================================
# SCRIMS Platform — Full Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# JSON Web Token Authentication
JWT_SECRET=scrims_super_secure_jwt_secret_esports_2026_production_key_xyz987
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH (Optional for local zero-config, required for cloud)
# ------------------------------------------------------------------------------
# If omitted or unconfigured, backend automatically operates in high-performance
# zero-config in-memory/persisted ACID store with pre-seeded test accounts.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-private-key

# ------------------------------------------------------------------------------
# 3. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Base API URL (defaults to proxy /api in Vite development server)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
